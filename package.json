    "test:e2e": "playwright test"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2"
  }
}
