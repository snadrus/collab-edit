{
  "name": "felarumi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node scripts/install-fil-folders.mjs",
    "start": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/server/index.ts",
    "dev": "DEV=1 node --disable-warning=ExperimentalWarning --watch-path=src/server --watch-path=src/shared --experimental-strip-types src/server/index.ts",
    "test": "node scripts/install-fil-folders.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts apps/felanumio/tests/*.test.ts p2p/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "playwright test",
    "test:p2p": "node scripts/install-fil-folders.mjs && playwright test -c p2p/playwright.config.ts",
    "p2p": "node scripts/install-fil-folders.mjs && node --disable-warning=ExperimentalWarning --experimental-strip-types p2p/serve.ts"
  },
  "externalGitDependencies": {
    "fil-folders": "git+https://github.com/snadrus/filecoin-folders.git#cc590b5ce4450c4f891d2374c87534b5940660a2"
  },
  "dependencies": {
    "@filoz/synapse-sdk": "^2.0.2",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "trystero": "^0.26.0",
    "viem": "^2.57.13",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2"
  }
}
